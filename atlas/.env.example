# =============================================================================
# CEVORYN — Environment Variables
# Copy to .env.local and fill in values
# =============================================================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cevoryn"
DIRECT_URL="postgresql://postgres:password@localhost:5432/cevoryn"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# OpenAI
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MAX_TOKENS="2048"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CEVORYN"

# Email (optional; both values are required to send team invites)
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="CEVORYN <team@your-domain.com>"

# Paddle Billing
PADDLE_ENV="sandbox"
PADDLE_API_KEY="pdl_sdbx_apikey_your-key"
PADDLE_WEBHOOK_SECRET="pdl_ntfset_your-endpoint-secret"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_your-client-token"
PADDLE_PRICE_STARTER="pri_your-starter-price"
PADDLE_PRICE_PROFESSIONAL="pri_your-professional-price"
PADDLE_PRICE_BUSINESS="pri_your-business-price"

# Polar Billing
POLAR_ENV="sandbox"
POLAR_ACCESS_TOKEN="polar_oat_your-organization-access-token"
POLAR_WEBHOOK_SECRET="whsec_your-webhook-secret"
POLAR_PRODUCT_STARTER="your-starter-product-id"
POLAR_PRODUCT_PROFESSIONAL="your-professional-product-id"
POLAR_PRODUCT_BUSINESS="your-business-product-id"

# Rate Limiting
DAILY_TOKEN_LIMIT_PER_ORG="500000"

# Feature Flags
NEXT_PUBLIC_ENABLE_AI="true"
