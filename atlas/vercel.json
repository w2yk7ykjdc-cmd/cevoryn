{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": null,
  "crons": [
    {
      "path": "/api/cron/cleanup-usage-reservations",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/cleanup-billing-hardening-records",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/radar-ingest",
      "schedule": "0 6 * * *"
    }
  ]
}
