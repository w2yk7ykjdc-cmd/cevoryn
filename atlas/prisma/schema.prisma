// =============================================================================
// Atlas — Prisma Schema
// Sprint 004: Atlas Brain Foundation
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Organization
// =============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members            Member[]
  invites            Invite[]
  conversations      Conversation[]
  usageRecords       UsageRecord[]
  memories           Memory[]
  insights           Insight[]
  pulseSnapshots     PulseSnapshot[]
  briefs             Brief[]
  preparedActions    PreparedAction[]
  decisions          Decision[]
  outcomeEvaluations OutcomeEvaluation[]
  learningPatterns   LearningPattern[]
  analyticsEvents    AnalyticsEvent[]
  subscription       Subscription?
  companyProfile     CompanyProfile?
  externalEntities   ExternalEntity[]
  externalSignals    ExternalSignal[]
  externalEvents     ExternalEvent[]
  opportunities      Opportunity[]
  notifications      Notification[]
  workerTasks        WorkerTask[]
  actionExecutions   ActionExecution[]
  auditLogs          AuditLog[]
  pipelineRuns       PipelineRun[]
  googleConnections  GoogleConnection[]

  @@map("organizations")
}

// =============================================================================
// GoogleConnection
//
// Table predates this schema file (created directly via a raw migration,
// never previously declared as a Prisma model) and every call site reads/
// writes it through prisma.$queryRaw/$executeRaw (see src/lib/google-
// connection.ts and src/app/api/integrations/google/**) rather than the
// Prisma Client. This model exists ONLY so `prisma migrate dev`'s schema
// diff sees this table as intentional - without it, Prisma has no record
// of "google_connections" and proposes dropping it as an orphan on the
// next migration, which is exactly what happened in the migration that
// shipped the Radar feature (20260906190948_add_radar_intelligence_layer
// dropped this table, taking every organization's connected Google
// account with it, and breaking every dashboard load that queries it).
// Column/index/constraint shapes below intentionally mirror the original
// 20260724150000_add_google_connections migration exactly.
// =============================================================================

model GoogleConnection {
  id                    String   @id @default(cuid())
  organizationId        String   @map("organization_id")
  userId                String   @map("user_id")
  googleEmail           String   @map("google_email")
  accessTokenEncrypted  String   @map("access_token_encrypted")
  refreshTokenEncrypted String?  @map("refresh_token_encrypted")
  expiresAt             DateTime @map("expires_at")
  scopes                String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("google_connections")
}

// =============================================================================
// Member
// =============================================================================

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Member {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  organizationId String     @map("organization_id")
  role           MemberRole @default(MEMBER)
  displayName    String     @map("display_name")
  avatarUrl      String?    @map("avatar_url")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("members")
}

// =============================================================================
// Invite
// =============================================================================

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  organizationId String       @map("organization_id")
  role           MemberRole   @default(MEMBER)
  status         InviteStatus @default(PENDING)
  invitedBy      String       @map("invited_by")
  token          String       @unique @default(cuid())
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([token])
  @@map("invites")
}

// =============================================================================
// Conversation
// =============================================================================

model Conversation {
  id             String   @id @default(cuid())
  title          String   @default("New conversation")
  organizationId String   @map("organization_id")
  createdById    String   @map("created_by_id")
  isArchived     Boolean  @default(false) @map("is_archived")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId, createdById])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("conversations")
}

// =============================================================================
// Message
// =============================================================================

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  model          String?
  inputTokens    Int?        @map("input_tokens")
  outputTokens   Int?        @map("output_tokens")
  durationMs     Int?        @map("duration_ms")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// =============================================================================
// Usage Tracking
// =============================================================================

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  conversationId String?  @map("conversation_id")
  model          String
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  totalTokens    Int      @map("total_tokens")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("usage_records")
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  event          String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([event, createdAt])
  @@map("analytics_events")
}

// =============================================================================
// Brain: Company Memory
// =============================================================================

enum MemoryCategory {
  DECISION
  PREFERENCE
  TEAM_DYNAMIC
  PROJECT_STATUS
  PROCESS
  GOAL
  FACT
}

enum MemorySource {
  CONVERSATION
  MANUAL
  INSIGHT
}

model Memory {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  category       MemoryCategory
  content        String
  source         MemorySource   @default(MANUAL)
  sourceId       String?        @map("source_id")
  confidence     Float          @default(1.0)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([organizationId, category])
  @@map("memories")
}

// =============================================================================
// Brain: Insights
// =============================================================================

enum InsightCategory {
  STRATEGIC
  OPERATIONAL
  TEAM
  FINANCIAL
  RISK
}

enum InsightSeverity {
  INFO
  SUGGESTION
  WARNING
  CRITICAL
}

enum InsightStatus {
  NEW
  ACKNOWLEDGED
  ACTED_ON
  DISMISSED
}

model Insight {
  id                String          @id @default(cuid())
  organizationId    String          @map("organization_id")
  category          InsightCategory
  severity          InsightSeverity @default(INFO)
  status            InsightStatus   @default(NEW)
  title             String
  summary           String          @default("")
  description       String
  impact            String          @default("")
  confidence        Float           @default(0.5)
  evidence          Json            @default("[]")
  reasoning         String          @default("")
  recommendedAction String          @default("") @map("recommended_action")
  priority          Int             @default(5)
  actionItems       Json            @default("[]") @map("action_items")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("insights")
}

// =============================================================================
// Brain: Company Pulse
// =============================================================================

enum PulsePeriod {
  DAILY
  WEEKLY
}

model PulseSnapshot {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  period         PulsePeriod
  metrics        Json
  periodStart    DateTime    @map("period_start")
  periodEnd      DateTime    @map("period_end")
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period, periodStart])
  @@index([organizationId, period, createdAt(sort: Desc)])
  @@map("pulse_snapshots")
}

// =============================================================================
// Brain: CEO Brief
// =============================================================================

enum BriefType {
  DAILY
  WEEKLY
}

model Brief {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  type           BriefType
  title          String
  sections       Json
  periodStart    DateTime  @map("period_start")
  periodEnd      DateTime  @map("period_end")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt(sort: Desc)])
  @@map("briefs")
}

// =============================================================================
// Brain: Action Center
// =============================================================================

enum ActionType {
  EMAIL_DRAFT
  TASK
  CALENDAR_PROPOSAL
  FOLLOW_UP
}

enum ActionStatus {
  PENDING
  APPROVED
  DISMISSED
}

model PreparedAction {
  id                  String       @id @default(cuid())
  organizationId      String       @map("organization_id")
  type                ActionType
  title               String
  description         String
  content             Json
  status              ActionStatus @default(PENDING)
  sourceInsightId     String?      @map("source_insight_id")
  /// Set when this action was generated from the Radar Opportunity Engine
  /// rather than the Brain Insight Engine - the two source fields are
  /// intentionally both optional/independent rather than a single
  /// polymorphic column, matching how the rest of this schema models
  /// optional provenance (e.g. Memory.sourceId).
  sourceOpportunityId String?      @map("source_opportunity_id")
  confidence          Float        @default(0.5)
  reasoning           String       @default("")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?      @relation(fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  executions   ActionExecution[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([sourceOpportunityId])
  @@map("prepared_actions")
}

// =============================================================================
// Brain: Decision Intelligence
// =============================================================================

enum DecisionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  IGNORED
  EXECUTED
  COMPLETED
  SUCCESSFUL
  FAILED
  UNKNOWN
}

model Decision {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  status         DecisionStatus @default(PROPOSED)
  canvas         Json
  priorityScore  Float          @map("priority_score")
  resolvedAt     DateTime?      @map("resolved_at")
  outcome        String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timelineEvents DecisionTimelineEvent[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("decisions")
}

enum TimelineEventType {
  PROBLEM_DETECTED
  CANVAS_GENERATED
  RECOMMENDATION_MADE
  USER_ACCEPTED
  USER_REJECTED
  USER_IGNORED
  EXECUTION_STARTED
  OUTCOME_RECORDED
  OUTCOME_EVALUATED
  LEARNING_EXTRACTED
  FOLLOW_UP_DUE
}

model DecisionTimelineEvent {
  id         String            @id @default(cuid())
  decisionId String            @map("decision_id")
  type       TimelineEventType
  content    String
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt])
  @@map("decision_timeline_events")
}

// =============================================================================
// Brain: Outcome Evaluation
// =============================================================================

enum OutcomeResult {
  SUCCESS
  FAILURE
  PARTIAL_SUCCESS
  NO_OUTCOME_YET
}

model OutcomeEvaluation {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  /// Nullable: an outcome evaluation is recorded against EITHER a Decision
  /// OR a Radar Opportunity (enforced at the service layer, not the DB -
  /// consistent with how other optional provenance fields in this schema,
  /// e.g. Memory.sourceId, are not DB-constrained either). Made nullable
  /// (was required) so the existing Decision outcome-evaluation pipeline
  /// is unaffected while Radar reuses the same table instead of a
  /// duplicate outcome-tracking system.
  decisionId     String?       @map("decision_id")
  opportunityId  String?       @map("opportunity_id")
  result         OutcomeResult
  outcomeScore   Float         @map("outcome_score")
  confidence     Float         @default(0.5)
  explanation    String
  evidence       Json          @default("[]")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([decisionId])
  @@index([opportunityId])
  @@map("outcome_evaluations")
}

// =============================================================================
// Brain: Learning Engine
// =============================================================================

model LearningPattern {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  patternType    String   @map("pattern_type")
  category       String
  pattern        String
  frequency      Int      @default(1)
  confidence     Float    @default(0.5)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, patternType])
  @@index([organizationId, category])
  @@map("learning_patterns")
}

// =============================================================================
// Billing: Subscriptions
//
// These tables are managed by hand-written migrations (prisma/migrations/
// 20260725233000_add_billing_subscriptions, 20260726161000_add_paddle_billing_provider)
// rather than `prisma migrate dev` against these models. The models below are a
// read/type-safety layer over that existing schema — do not run `prisma migrate dev`
// against this section, it will try to "correct" the partial unique indexes on
// paddle_customer_id/paddle_subscription_id (WHERE ... IS NOT NULL) that Prisma's
// `@unique` cannot express, which is why those two columns are intentionally left
// without a `@unique` annotation here.
// =============================================================================

enum BillingPlan {
  STARTER
  PROFESSIONAL
  BUSINESS
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique @map("organization_id")
  stripeCustomerId     String             @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  paddleCustomerId     String?            @map("paddle_customer_id")
  paddleSubscriptionId String?            @map("paddle_subscription_id")
  paddlePriceId        String?            @map("paddle_price_id")
  polarCustomerId      String?            @map("polar_customer_id")
  polarSubscriptionId  String?            @map("polar_subscription_id")
  polarProductId       String?            @map("polar_product_id")
  plan                 BillingPlan        @default(STARTER)
  subscriptionStatus   SubscriptionStatus @default(INCOMPLETE) @map("subscription_status")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  trialEnd             DateTime?          @map("trial_end")
  /// Timestamp of the last Polar webhook event actually applied to this row -
  /// used to reject an older, redelivered/delayed event from overwriting
  /// state a newer event already wrote. Null for rows never touched by a
  /// Polar webhook (pre-Polar rows, or Paddle-era rows).
  lastWebhookEventAt   DateTime?          @map("last_webhook_event_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([subscriptionStatus])
  @@index([plan])
  @@map("subscriptions")
}

model BillingWebhookEvent {
  provider  String
  eventId   String   @map("event_id")
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([provider, eventId])
  @@map("billing_webhook_events")
}

/**
 * One row per pre-authentication attempt (login, signup, forgot-password),
 * keyed by an action+identity string (e.g. "login_email"/"user@x.com" or
 * "login_ip"/"1.2.3.4"). Not tied to an organization — these actions run
 * before a user has one. Rows are only ever inserted/counted, never updated.
 */
model AuthRateLimitAttempt {
  id        String   @id @default(cuid())
  action    String
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, key, createdAt])
  @@map("auth_rate_limit_attempts")
}

// =============================================================================
// Radar: Structured Company Profile
//
// Canonical, user-declared context about what this organization's business
// actually is - distinct from Memory, which stays the emergent/learned
// context extracted from chat. The Opportunity Engine matches external
// Events against this structured profile; Memory alone was too unstructured
// to match against reliably.
// =============================================================================

model CompanyProfile {
  id                     String   @id @default(cuid())
  organizationId         String   @unique @map("organization_id")
  description            String   @default("")
  industry               String?
  products               String[] @default([])
  services               String[] @default([])
  targetMarkets          String[] @default([]) @map("target_markets")
  targetCustomers        String   @default("") @map("target_customers")
  idealCustomerProfile   String   @default("") @map("ideal_customer_profile")
  geographies            String[] @default([])
  competitors            String[] @default([])
  suppliers              String[] @default([])
  businessModel          String   @default("") @map("business_model")
  averageDealSize        Float?   @map("average_deal_size")
  strategicGoals         String[] @default([]) @map("strategic_goals")
  strategicPriorities    String[] @default([]) @map("strategic_priorities")
  capabilities           String[] @default([])
  constraints            String[] @default([])
  /// Phase 2 additions - all additive/optional so existing profiles remain
  /// valid without a data migration; surfaced in the UI via progressive
  /// disclosure (collapsed "Advanced" section), not the main form.
  knownCustomers         String[] @default([]) @map("known_customers")
  growthObjectives       String[] @default([]) @map("growth_objectives")
  preferredOpportunities String[] @default([]) @map("preferred_opportunities")
  excludedOpportunities  String[] @default([]) @map("excluded_opportunities")
  companySize            String?  @map("company_size")
  revenueRange           String?  @map("revenue_range")
  preferredCurrency      String   @default("EUR") @map("preferred_currency")
  customContext          String   @default("") @map("custom_context")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

// =============================================================================
// Radar: External Entity System
//
// Tracked external companies (the org's own watchlist - prospects,
// customers, competitors, suppliers). `type` is COMPANY-only today but kept
// as an enum specifically so PERSON/PRODUCT/MARKET/TECHNOLOGY can be added
// later without a new model. Each row is org-scoped (not a shared global
// company registry), so no cross-tenant entity-resolution problem exists at
// this stage - two orgs watching "the same" real company simply get two
// independent rows, which is correct for MVP scope.
// =============================================================================

enum ExternalEntityType {
  COMPANY
}

enum WatchReason {
  PROSPECT
  CUSTOMER
  COMPETITOR
  SUPPLIER
  OTHER
}

model ExternalEntity {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  type           ExternalEntityType @default(COMPANY)
  name           String
  normalizedName String             @map("normalized_name")
  domain         String?
  industry       String?
  country        String?
  watchReason    WatchReason        @map("watch_reason")
  isActive       Boolean            @default(true) @map("is_active")
  /// Distinct from isActive (a soft delete): a paused entity stays visible
  /// on the watchlist and keeps its history, but the ingestion pipeline
  /// skips it - unlike isActive:false, which also drops it from the
  /// default list view.
  isPaused       Boolean            @default(false) @map("is_paused")
  priority       Int                @default(5)
  tags           String[]           @default([])
  notes          String             @default("")
  addedByUserId  String             @map("added_by_user_id")
  /// Per-entity adapter configuration, e.g. { "greenhouseToken": "acme" }
  /// for the Jobs adapter. Absence of a key means that adapter is simply
  /// not configured for this entity - not an error.
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signals       ExternalSignal[]
  events        ExternalEvent[]
  opportunities Opportunity[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, isActive])
  @@map("external_entities")
}

// =============================================================================
// Radar: External Signal Layer
//
// Raw ingested items, normalized just enough to dedupe and route - NOT yet
// interpreted. `hash` (sha256 of source+sourceUrl+title) plus the unique
// constraint below is what makes re-ingestion idempotent: a re-run of the
// same adapter over the same feed silently no-ops on already-seen items
// instead of creating duplicates or re-processing them.
// =============================================================================

enum SignalSourceType {
  JOB_POSTING
  PRESS_RELEASE
  SEC_FILING
}

enum SignalStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

model ExternalSignal {
  id               String           @id @default(cuid())
  organizationId   String           @map("organization_id")
  externalEntityId String           @map("external_entity_id")
  source           String
  sourceType       SignalSourceType @map("source_type")
  sourceUrl        String           @map("source_url")
  title            String
  /// Untrusted external data. Never treated as instructions - see
  /// event-extractor.ts's prompt-injection handling.
  rawContent       String           @map("raw_content")
  publishedAt      DateTime?        @map("published_at")
  observedAt       DateTime         @default(now()) @map("observed_at")
  hash             String
  metadata         Json             @default("{}")
  status           SignalStatus     @default(PENDING)
  createdAt        DateTime         @default(now()) @map("created_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalEntity ExternalEntity @relation(fields: [externalEntityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, hash])
  @@index([organizationId, status])
  @@index([externalEntityId, observedAt(sort: Desc)])
  @@map("external_signals")
}

// =============================================================================
// Radar: Event Engine
//
// Structured, LLM-classified events derived from one or more ExternalSignal
// rows. Shape deliberately mirrors Insight (status lifecycle, evidence Json,
// confidence) so the Intelligence Engine can treat both uniformly.
// =============================================================================

enum ExternalEventType {
  HIRING_ACCELERATION
  HIRING_DECLINE
  EXPANSION
  NEW_FACILITY
  LEADERSHIP_CHANGE
  FUNDING
  ACQUISITION
  PRODUCT_LAUNCH
  PARTNERSHIP
  PROCUREMENT
  MARKET_ENTRY
  REGULATORY_CHANGE
}

enum ExternalEventStatus {
  NEW
  ANALYZED
  DISMISSED
}

model ExternalEvent {
  id               String              @id @default(cuid())
  organizationId   String              @map("organization_id")
  externalEntityId String              @map("external_entity_id")
  type             ExternalEventType
  title            String
  description      String
  occurredAt       DateTime            @map("occurred_at")
  confidence       Float
  evidence         Json                @default("[]")
  source           String
  metadata         Json                @default("{}")
  status           ExternalEventStatus @default(NEW)
  createdAt        DateTime            @default(now()) @map("created_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalEntity ExternalEntity @relation(fields: [externalEntityId], references: [id], onDelete: Cascade)
  opportunities  Opportunity[]

  @@index([organizationId, status])
  @@index([externalEntityId, occurredAt(sort: Desc)])
  @@map("external_events")
}

// =============================================================================
// Radar: Opportunity Engine (covers both OPPORTUNITY and THREAT polarity -
// intentionally one model, not two parallel engines, per the instruction not
// to duplicate architecture for what is the same shape with an inverted
// sign)
// =============================================================================

enum OpportunityPolarity {
  OPPORTUNITY
  THREAT
}

enum OpportunityStatus {
  NEW
  REVIEWING
  QUALIFIED
  ACTED_ON
  WON
  LOST
  DISMISSED
}

model Opportunity {
  id                String              @id @default(cuid())
  organizationId    String              @map("organization_id")
  externalEntityId  String              @map("external_entity_id")
  eventId           String              @map("event_id")
  polarity          OpportunityPolarity @default(OPPORTUNITY)
  title             String
  description       String
  /// Value estimates are always a range, never a single fake-precise
  /// figure - both nullable because a low-confidence opportunity may not
  /// support a value estimate at all yet.
  estimatedValueMin Float?              @map("estimated_value_min")
  estimatedValueMax Float?              @map("estimated_value_max")
  currency          String              @default("EUR")
  probability       Float
  confidence        Float
  strategicFit      Float               @map("strategic_fit")
  timeHorizon       String              @map("time_horizon")
  reasoning         String
  /// A short, concrete suggested next step (e.g. "Reach out to their VP of
  /// Engineering about the new facility"), distinct from `reasoning` (why
  /// this matters) - default "" so existing rows remain valid without a
  /// data migration.
  recommendedAction String              @default("") @map("recommended_action")
  evidence          Json                @default("[]")
  score             Float
  scoreBreakdown    Json                @map("score_breakdown")
  priority          Int                 @default(5)
  status            OpportunityStatus   @default(NEW)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalEntity     ExternalEntity      @relation(fields: [externalEntityId], references: [id], onDelete: Cascade)
  event              ExternalEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  preparedActions    PreparedAction[]
  outcomeEvaluations OutcomeEvaluation[]
  workerTasks        WorkerTask[]

  @@index([organizationId, status])
  @@index([organizationId, polarity, createdAt(sort: Desc)])
  @@index([externalEntityId])
  @@map("opportunities")
}

// =============================================================================
// Radar: Notifications
// =============================================================================

enum NotificationType {
  NEW_OPPORTUNITY
  HIGH_PRIORITY_EVENT
  THREAT_DETECTED
  ACTION_REQUIRED
  ACTION_COMPLETED
  RESEARCH_COMPLETED
  SYSTEM_ALERT
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  /// Null = broadcast to the whole organization rather than one member.
  userId         String?          @map("user_id")
  type           NotificationType
  title          String
  body           String
  entityType     String?          @map("entity_type")
  entityId       String?          @map("entity_id")
  readAt         DateTime?        @map("read_at")
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("notifications")
}

// =============================================================================
// Radar: AI Worker Foundation
//
// Generic Worker/Task pattern - Research is the only concrete worker today
// (WorkerType has one value), but the shape (type/status/input via
// opportunityId+requestedByUserId/output via brief+evidence/error) is
// designed so a future Sales/Competitive-Intelligence/Finance worker can
// reuse this same table and lifecycle rather than a new one per worker
// type. See src/features/radar/workers/types.ts for the code-level Worker
// interface this table backs.
// =============================================================================

enum WorkerType {
  RESEARCH
}

enum WorkerTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model WorkerTask {
  id                String           @id @default(cuid())
  organizationId    String           @map("organization_id")
  workerType        WorkerType       @default(RESEARCH) @map("worker_type")
  opportunityId     String           @map("opportunity_id")
  requestedByUserId String           @map("requested_by_user_id")
  status            WorkerTaskStatus @default(PENDING)
  /// Worker output - a text brief for the Research worker today; future
  /// worker types may use this for a different textual result, or leave it
  /// null and rely solely on `evidence`/`error`.
  brief             String?
  evidence          Json             @default("[]")
  error             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  completedAt       DateTime?        @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, workerType])
  @@index([opportunityId])
  @@map("worker_tasks")
}

// =============================================================================
// Radar: Action Engine extension
//
// Records what actually happened after a PreparedAction was approved -
// PreparedAction itself (title/description/content/status) is unchanged and
// still drives the existing mailto/clipboard/Google-draft/Google-calendar
// approval UI (action-handoff.ts); this table just gives that existing flow
// a persistent execution record instead of a fire-and-forget client action.
// =============================================================================

enum ActionExecutionChannel {
  MAILTO
  CLIPBOARD
  GOOGLE_EMAIL_DRAFT
  GOOGLE_CALENDAR_EVENT
  RESEARCH_WORKER
}

enum ActionExecutionStatus {
  STARTED
  COMPLETED
  FAILED
}

model ActionExecution {
  id               String                 @id @default(cuid())
  organizationId   String                 @map("organization_id")
  preparedActionId String                 @map("prepared_action_id")
  channel          ActionExecutionChannel
  status           ActionExecutionStatus  @default(STARTED)
  result           Json?
  error            String?
  startedAt        DateTime               @default(now()) @map("started_at")
  completedAt      DateTime?              @map("completed_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preparedAction PreparedAction @relation(fields: [preparedActionId], references: [id], onDelete: Cascade)

  @@index([organizationId, preparedActionId])
  @@map("action_executions")
}

// =============================================================================
// Enterprise Foundation: Audit Log
//
// General-purpose "who did what" trail, distinct from DecisionTimelineEvent
// (which only covers a Decision's own lifecycle). Written from within the
// service functions that perform a sensitive action (entity add/remove,
// company profile change, opportunity status change, action approval/
// execution) rather than at the API-route layer, so it captures the real
// mutation regardless of which route or background job triggered it.
// =============================================================================

enum AuditActorType {
  USER
  SYSTEM
  CRON
  AI_WORKER
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  actorType      AuditActorType @map("actor_type")
  /// userId for USER, worker/job identifier for AI_WORKER/CRON, null for SYSTEM.
  actorId        String?        @map("actor_id")
  /// Dot-namespaced action name, e.g. "entity.created", "opportunity.status_changed".
  action         String
  resourceType   String         @map("resource_type")
  resourceId     String?        @map("resource_id")
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}

// =============================================================================
// Radar: Pipeline Observability
//
// One row per runRadarPipelineForOrganization() execution - real structured
// data for production debugging (section 18), not just console.warn. Kept
// as a flat summary row (not per-stage rows) since the pipeline itself is
// small enough today that stage-level granularity isn't needed yet; the
// `errors` Json array already carries a per-stage-prefixed message list.
// =============================================================================

enum PipelineRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model PipelineRun {
  id                   String            @id @default(cuid())
  organizationId       String            @map("organization_id")
  status               PipelineRunStatus @default(RUNNING)
  signalsIngested      Int               @default(0) @map("signals_ingested")
  eventsCreated        Int               @default(0) @map("events_created")
  opportunitiesCreated Int               @default(0) @map("opportunities_created")
  errorCount           Int               @default(0) @map("error_count")
  errors               Json              @default("[]")
  startedAt            DateTime          @default(now()) @map("started_at")
  completedAt          DateTime?         @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt(sort: Desc)])
  @@map("pipeline_runs")
}
