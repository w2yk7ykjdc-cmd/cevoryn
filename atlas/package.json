{
  "name": "cevoryn",
  "version": "1.0.0-rc.3",
  "private": true,
  "description": "CEVORYN — AI Chief of Staff for small teams",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && node scripts/deploy-migrate.mjs && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push:dev": "prisma db push",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check-destructive-migrations": "node scripts/check-destructive-migrations.mjs",
    "db:seed:romance": "tsx prisma/seed-romance.ts",
    "gdpr:export": "tsx scripts/gdpr-export-organization.ts",
    "gdpr:delete": "tsx scripts/gdpr-delete-organization.ts",
    "gdpr:export:romance": "tsx scripts/gdpr-export-romance-player.ts",
    "gdpr:delete:romance": "tsx scripts/gdpr-delete-romance-player.ts",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "test": "tsx --test test/**/*.test.ts",
    "test:integration": "NODE_OPTIONS=--conditions=react-server tsx --test --test-concurrency=1 test/integration/*.integration.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@sentry/nextjs": "^10.75.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.12",
    "@tanstack/react-query": "^5.62.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "next-intl": "^4.13.4",
    "openai": "^4.77.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.20",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "jsdom": "30.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
