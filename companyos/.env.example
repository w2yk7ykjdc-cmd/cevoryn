# ─────────────────────────────────────────────────────────────────────────
# CompanyOS environment configuration
# Copy this file to .env (local dev) and fill in real values.
# All variables are validated at startup by src/env.ts — the process will
# refuse to boot if a required value is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of this deployment (no trailing slash).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL via Prisma) ───────────────────────────────────
# Pooled connection, used by the app at request time.
DATABASE_URL=postgresql://companyos:companyos@localhost:5432/companyos?schema=public
# Direct (non-pooled) connection, used for migrations.
DIRECT_URL=postgresql://companyos:companyos@localhost:5432/companyos?schema=public

# ── Redis (caching, rate limiting, event bus, job queues) ─────────────
REDIS_URL=redis://localhost:6379

# ── Auth (Better Auth) ──────────────────────────────────────────────────
# 32+ byte random secret used to sign sessions/tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-value-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (optional — leave blank to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Transactional email (invitations, password reset) ──────────────────
EMAIL_FROM=CompanyOS <noreply@example.com>
RESEND_API_KEY=

# ── AI providers (at least one required for AI features) ──────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Default provider/model used by the AI Runtime when a request does not
# pin one explicitly. provider must be one of: openai | anthropic | google
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-5

# ── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ── Structured logging ──────────────────────────────────────────────────
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Background jobs ─────────────────────────────────────────────────────
JOB_QUEUE_PREFIX=companyos
