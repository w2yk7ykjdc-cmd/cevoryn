# Test-only overrides, loaded before .env by tests/setup.ts. Not secrets —
# STRIPE_SECRET_KEY stays unset in tests (billing tests always inject a fake
# PaymentProvider rather than calling real Stripe), these two ids just let
# the plan catalog seed with non-null stripePriceId values so
# createCheckoutSessionForOrg's "no configured price" guard doesn't fire.
STRIPE_PRICE_ID_PRO=price_test_pro
STRIPE_PRICE_ID_ENTERPRISE=price_test_enterprise
