generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                    String          @id
  name                  String
  email                 String
  emailVerified         Boolean         @default(false)
  image                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  role                  String?
  banned                Boolean?        @default(false)
  banReason             String?
  banExpires            DateTime?
  sessions              Session[]
  accounts              Account[]
  members               Member[]
  invitations           Invitation[]
  apiKeys               ApiKey[]
  conversations         Conversation[]
  memoryRecords         MemoryRecord[]
  companiesCreated      Company[]
  contactsCreated       Contact[]
  contactNotes          ContactNote[]
  leadsOwned            Lead[]          @relation("LeadOwner")
  leadsCreated          Lead[]          @relation("LeadCreatedBy")
  leadActivities        LeadActivity[]
  tasksAssigned         Task[]          @relation("TaskAssignee")
  tasksCreated          Task[]          @relation("TaskCreatedBy")
  agentRuns             AgentRun[]
  agentApprovalsDecided AgentApproval[] @relation("AgentApprovalDecidedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                String             @id
  name              String
  slug              String
  logo              String?
  createdAt         DateTime
  metadata          String?
  organizationroles OrganizationRole[]
  members           Member[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  domainEvents      DomainEvent[]
  apiKeys           ApiKey[]
  conversations     Conversation[]
  memoryRecords     MemoryRecord[]
  companies         Company[]
  contacts          Contact[]
  tags              Tag[]
  pipelineStages    PipelineStage[]
  leads             Lead[]
  leadActivities    LeadActivity[]
  tasks             Task[]
  agentRuns         AgentRun[]
  agentApprovals    AgentApproval[]
  subscription      Subscription?
  usageRecords      UsageRecord[]
  companySignals    CompanySignal[]

  @@unique([slug])
  @@map("organization")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit trail
// ─────────────────────────────────────────────────────────────────────────

/// Immutable, append-only compliance log. Never updated or deleted by the
/// application. One row per state-changing action across the tenant.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actorType      String
  action         String
  targetType     String
  targetId       String
  metadata       Json         @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, targetType, targetId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Event bus (transactional outbox)
// ─────────────────────────────────────────────────────────────────────────

/// Durable outbox row for every domain event. `processedAt` is set once the
/// event has been published to Redis; unprocessed rows are replayed by the
/// background relay job so a Redis outage never silently drops an event.
model DomainEvent {
  id             String        @id @default(cuid())
  type           String
  payload        Json
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  processedAt    DateTime?

  @@index([processedAt, createdAt])
  @@index([organizationId, type])
  @@map("domain_event")
}

// ─────────────────────────────────────────────────────────────────────────
// API keys (programmatic + agent tool access)
// ─────────────────────────────────────────────────────────────────────────

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name           String
  keyPrefix      String
  keyHash        String
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([keyHash])
  @@index([organizationId])
  @@index([keyPrefix])
  @@map("api_key")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Runtime: conversations, messages, tool invocations, memory
// ─────────────────────────────────────────────────────────────────────────

enum MessageRole {
  system
  user
  assistant
  tool
}

model Conversation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String?
  provider       String
  model          String
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       Message[]
  toolCalls      ToolInvocation[]
  memoryRecords  MemoryRecord[]
  agentRuns      AgentRun[]

  @@index([organizationId, userId, createdAt])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  toolCallId     String?
  toolName       String?
  toolArgs       Json?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

/// One row per tool invocation the AI Runtime executes on behalf of a
/// conversation. Kept separately from `Message` so tool executions remain
/// auditable and queryable (latency, failure rate, permission denials) even
/// though a summarized result is also appended to the conversation as a
/// `tool` message.
model ToolInvocation {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName       String
  input          Json
  output         Json?
  status         String
  errorMessage   String?
  durationMs     Int
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([toolName, status])
  @@map("tool_invocation")
}

enum MemoryKind {
  fact
  preference
  summary
}

/// Long-term memory store. `embedding` is a pgvector column queried with raw
/// SQL cosine-distance operators (Prisma has no native vector query builder
/// yet) — see `src/server/ai/memory/long-term.ts`.
model MemoryRecord {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?                @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  kind           MemoryKind
  content        String
  embedding      Unsupported("vector(1536)")?
  metadata       Json                         @default("{}")
  createdAt      DateTime                     @default(now())

  @@index([organizationId, kind])
  @@map("memory_record")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 1: CRM domain — Companies, Contacts, Leads, Tasks
// ─────────────────────────────────────────────────────────────────────────

model Company {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String?
  industry       String?
  website        String?
  description    String?
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  contacts       Contact[]
  leads          Lead[]
  tasks          Task[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
  @@map("company")
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  createdAt      DateTime     @default(now())
  contacts       ContactTag[]

  @@unique([organizationId, name])
  @@map("tag")
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  title          String?
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  tags           ContactTag[]
  notes          ContactNote[]
  leads          Lead[]
  tasks          Task[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, companyId])
  @@map("contact")
}

model ContactTag {
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([contactId, tagId])
  @@map("contact_tag")
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
  @@map("contact_note")
}

/// Organization-scoped, ordered pipeline stage. Every org gets a sensible
/// default set seeded on creation (see organizationHooks.afterCreateOrganization
/// in src/server/auth/auth.ts); orgs can add their own via the Leads service.
model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  order          Int
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  leads          Lead[]

  @@unique([organizationId, name])
  @@index([organizationId, order])
  @@map("pipeline_stage")
}

model Lead {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String
  stageId        String
  stage          PipelineStage  @relation(fields: [stageId], references: [id])
  value          Decimal        @default(0) @db.Decimal(14, 2)
  probability    Int            @default(0)
  source         String?
  ownerId        String?
  owner          User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?          @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  closedAt       DateTime?
  activities     LeadActivity[]
  tasks          Task[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, stageId])
  @@index([organizationId, companyId])
  @@map("lead")
}

enum LeadActivityType {
  note
  stage_changed
  task_created
  ai_note
  ai_analysis
  email
  call
  meeting
}

/// Append-only timeline for a lead. Written by user actions (notes, manual
/// stage changes) and by the AI Sales Employee's tools (ai_note, ai_analysis)
/// — never updated or deleted.
model LeadActivity {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           LeadActivityType
  body           String?
  metadata       Json             @default("{}")
  actorId        String?
  actor          User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([organizationId, type])
  @@map("lead_activity")
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TaskStatus   @default(todo)
  priority       TaskPriority @default(medium)
  dueDate        DateTime?
  reminderAt     DateTime?
  reminderSentAt DateTime?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?
  deletedAt      DateTime?

  @@index([organizationId, deletedAt])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, dueDate])
  @@index([leadId])
  @@map("task")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 2: Agent orchestration — multi-step planning, tool execution,
// human-in-the-loop approval for the AI Sales Employee
// ─────────────────────────────────────────────────────────────────────────

enum AgentRunStatus {
  planning
  running
  waiting_approval
  completed
  failed
  rejected
}

enum AgentStepStatus {
  pending
  running
  succeeded
  failed
  skipped
}

enum AgentApprovalStatus {
  pending
  approved
  rejected
}

/// One row per user request handed to the AI Sales Employee agent. Tracks
/// the plan the model proposed and the overall outcome of executing it.
/// `goal` is the original user instruction; `plan` is the ordered list of
/// proposed tool calls the planner produced (informational — `AgentStep`
/// rows are the source of truth for what actually ran).
model AgentRun {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  goal           String
  plan           Json
  status         AgentRunStatus  @default(planning)
  resultSummary  String?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?
  steps          AgentStep[]
  approvals      AgentApproval[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([conversationId])
  @@map("agent_run")
}

/// One row per planned tool call within an `AgentRun`, in execution order.
/// `input`/`output` mirror `ToolInvocation` but are scoped to the run so a
/// run's full step-by-step trace can be reconstructed and displayed without
/// joining across conversations.
model AgentStep {
  id           String          @id @default(cuid())
  agentRunId   String
  agentRun     AgentRun        @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  stepIndex    Int
  toolName     String
  input        Json
  output       Json?
  status       AgentStepStatus @default(pending)
  errorMessage String?
  approvalId   String?         @unique
  approval     AgentApproval?  @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())

  @@unique([agentRunId, stepIndex])
  @@index([agentRunId])
  @@map("agent_step")
}

/// A human-approval gate for a single risky step. Created when the agent
/// reaches a step whose tool is classified as requiring approval; the run
/// halts in `waiting_approval` until a member with the underlying tool's
/// own required permission approves or rejects it.
model AgentApproval {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentRunId     String
  agentRun       AgentRun            @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  step           AgentStep?
  toolName       String
  input          Json
  reason         String
  status         AgentApprovalStatus @default(pending)
  decidedById    String?
  decidedBy      User?               @relation("AgentApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime            @default(now())

  @@index([organizationId, status])
  @@index([agentRunId])
  @@map("agent_approval")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 3: Billing — plans, subscriptions, usage metering
// ─────────────────────────────────────────────────────────────────────────

enum PlanTier {
  free
  pro
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

enum UsageMetric {
  ai_tokens
  agent_run
}

/// The billing plan catalog. A small, global reference table (no
/// organizationId — every organization can subscribe to any plan), seeded
/// idempotently at runtime by `ensurePlansSeeded()` rather than via a
/// migration data step, so it needs no separate seed script in CI.
model Plan {
  id                String         @id @default(cuid())
  tier              PlanTier       @unique
  name              String
  monthlyPriceCents Int
  stripePriceId     String?        @unique
  aiTokenLimit      Int
  agentRunLimit     Int
  seatLimit         Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subscriptions     Subscription[]

  @@map("plan")
}

/// One row per organization — every organization has exactly one
/// subscription, provisioned onto the free plan at creation time
/// (`provisionDefaultSubscription`, called from the same
/// `afterCreateOrganization` hook Sprint 1 used for pipeline seeding) and
/// upgraded/downgraded via Stripe checkout + webhooks thereafter.
model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(trialing)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@map("subscription")
}

/// Append-only usage ledger. Current-period usage for a metric is computed
/// on read by summing rows within `[currentPeriodStart, currentPeriodEnd)`
/// of the organization's `Subscription` — there is no running counter to
/// keep in sync, so a missed decrement can never happen.
model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric         UsageMetric
  quantity       Int
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())

  @@index([organizationId, metric, createdAt])
  @@map("usage_record")
}

/// Idempotency ledger for inbound Stripe webhook events — the event's own
/// Stripe id is the primary key, so a redelivered event is a no-op insert
/// failure the handler catches rather than double-applying a state change.
model BillingWebhookEvent {
  id          String   @id
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@map("billing_webhook_event")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 5: Intelligence — Company Events & Signal Foundation
// ─────────────────────────────────────────────────────────────────────────

enum SignalSourceType {
  domain_event
  scanner
}

enum SignalSeverity {
  low
  medium
  high
  critical
}

enum SignalStatus {
  active
  resolved
  expired
}

/// Durable, queryable ledger of normalized business signals — the landing
/// point for both real-time domain events (`sourceType: domain_event`, via
/// `src/server/intelligence/signals/subscriber.ts`) and periodic deterministic
/// detection rules (`sourceType: scanner`, via
/// `src/server/intelligence/signals/scanner.ts`). `type` is intentionally a
/// free-form String (like `AuditLog.action`/`DomainEvent.type`), not an enum,
/// since the signal vocabulary is expected to grow with every future
/// Opportunity/Risk rule without needing a migration per addition.
/// `relatedEntityType`/`relatedEntityId` are a deliberate soft reference
/// (not a Prisma relation) so this model never requires a back-relation on
/// Lead/Task/Contact/Company — those models are untouched by this sprint.
model CompanySignal {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type              String
  sourceType        SignalSourceType
  sourceId          String
  payload           Json             @default("{}")
  severity          SignalSeverity
  confidence        Int
  relatedEntityType String?
  relatedEntityId   String?
  detectedAt        DateTime         @default(now())
  ruleName          String
  ruleVersion       String
  status            SignalStatus     @default(active)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([organizationId, sourceType, ruleName, ruleVersion, sourceId])
  @@index([organizationId, detectedAt])
  @@index([organizationId, relatedEntityType, relatedEntityId])
  @@index([organizationId, status])
  @@map("company_signal")
}
