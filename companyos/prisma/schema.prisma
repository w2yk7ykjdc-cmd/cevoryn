generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                    String          @id
  name                  String
  email                 String
  emailVerified         Boolean         @default(false)
  image                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  role                  String?
  banned                Boolean?        @default(false)
  banReason             String?
  banExpires            DateTime?
  sessions              Session[]
  accounts              Account[]
  members               Member[]
  invitations           Invitation[]
  apiKeys               ApiKey[]
  conversations         Conversation[]
  memoryRecords         MemoryRecord[]
  companiesCreated      Company[]
  contactsCreated       Contact[]
  contactNotes          ContactNote[]
  leadsOwned            Lead[]          @relation("LeadOwner")
  leadsCreated          Lead[]          @relation("LeadCreatedBy")
  leadActivities        LeadActivity[]
  tasksAssigned         Task[]          @relation("TaskAssignee")
  tasksCreated          Task[]          @relation("TaskCreatedBy")
  agentRuns             AgentRun[]
  agentApprovalsDecided AgentApproval[] @relation("AgentApprovalDecidedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                       String                   @id
  name                     String
  slug                     String
  logo                     String?
  createdAt                DateTime
  metadata                 String?
  organizationroles        OrganizationRole[]
  members                  Member[]
  invitations              Invitation[]
  auditLogs                AuditLog[]
  domainEvents             DomainEvent[]
  apiKeys                  ApiKey[]
  conversations            Conversation[]
  memoryRecords            MemoryRecord[]
  companies                Company[]
  contacts                 Contact[]
  tags                     Tag[]
  pipelineStages           PipelineStage[]
  leads                    Lead[]
  leadActivities           LeadActivity[]
  tasks                    Task[]
  agentRuns                AgentRun[]
  agentApprovals           AgentApproval[]
  subscription             Subscription?
  usageRecords             UsageRecord[]
  companySignals           CompanySignal[]
  healthSnapshots          CompanyHealthSnapshot[]
  opportunities            Opportunity[]
  risks                    Risk[]
  decisions                Decision[]
  autonomyPolicies         AutonomyPolicy[]
  autonomyPolicyVersions   AutonomyPolicyVersion[]
  autonomyAllowlistEntries AutonomyAllowlistEntry[]
  autonomousActionLogs     AutonomousActionLog[]
  outcomes                 Outcome[]
  learningRecords          LearningRecord[]
  paperAccount             PaperAccount?
  paperPositions           PaperPosition[]
  paperTrades              PaperTrade[]

  @@unique([slug])
  @@map("organization")
}

model OrganizationRole {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit trail
// ─────────────────────────────────────────────────────────────────────────

/// Immutable, append-only compliance log. Never updated or deleted by the
/// application. One row per state-changing action across the tenant.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actorType      String
  action         String
  targetType     String
  targetId       String
  metadata       Json         @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, targetType, targetId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Event bus (transactional outbox)
// ─────────────────────────────────────────────────────────────────────────

/// Durable outbox row for every domain event. `processedAt` is set once the
/// event has been published to Redis; unprocessed rows are replayed by the
/// background relay job so a Redis outage never silently drops an event.
model DomainEvent {
  id             String        @id @default(cuid())
  type           String
  payload        Json
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  processedAt    DateTime?

  @@index([processedAt, createdAt])
  @@index([organizationId, type])
  @@map("domain_event")
}

// ─────────────────────────────────────────────────────────────────────────
// API keys (programmatic + agent tool access)
// ─────────────────────────────────────────────────────────────────────────

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name           String
  keyPrefix      String
  keyHash        String
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([keyHash])
  @@index([organizationId])
  @@index([keyPrefix])
  @@map("api_key")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Runtime: conversations, messages, tool invocations, memory
// ─────────────────────────────────────────────────────────────────────────

enum MessageRole {
  system
  user
  assistant
  tool
}

model Conversation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  title          String?
  provider       String
  model          String
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  messages       Message[]
  toolCalls      ToolInvocation[]
  memoryRecords  MemoryRecord[]
  agentRuns      AgentRun[]

  @@index([organizationId, userId, createdAt])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  toolCallId     String?
  toolName       String?
  toolArgs       Json?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

/// One row per tool invocation the AI Runtime executes on behalf of a
/// conversation. Kept separately from `Message` so tool executions remain
/// auditable and queryable (latency, failure rate, permission denials) even
/// though a summarized result is also appended to the conversation as a
/// `tool` message.
model ToolInvocation {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName       String
  input          Json
  output         Json?
  status         String
  errorMessage   String?
  durationMs     Int
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([toolName, status])
  @@map("tool_invocation")
}

enum MemoryKind {
  fact
  preference
  summary
}

/// Long-term memory store. `embedding` is a pgvector column queried with raw
/// SQL cosine-distance operators (Prisma has no native vector query builder
/// yet) — see `src/server/ai/memory/long-term.ts`.
model MemoryRecord {
  id             String                       @id @default(cuid())
  organizationId String
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?                @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  kind           MemoryKind
  content        String
  embedding      Unsupported("vector(1536)")?
  metadata       Json                         @default("{}")
  createdAt      DateTime                     @default(now())

  @@index([organizationId, kind])
  @@map("memory_record")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 1: CRM domain — Companies, Contacts, Leads, Tasks
// ─────────────────────────────────────────────────────────────────────────

model Company {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String?
  industry       String?
  website        String?
  description    String?
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  contacts       Contact[]
  leads          Lead[]
  tasks          Task[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
  @@map("company")
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  createdAt      DateTime     @default(now())
  contacts       ContactTag[]

  @@unique([organizationId, name])
  @@map("tag")
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  title          String?
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  tags           ContactTag[]
  notes          ContactNote[]
  leads          Lead[]
  tasks          Task[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, companyId])
  @@map("contact")
}

model ContactTag {
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([contactId, tagId])
  @@map("contact_tag")
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
  @@map("contact_note")
}

/// Organization-scoped, ordered pipeline stage. Every org gets a sensible
/// default set seeded on creation (see organizationHooks.afterCreateOrganization
/// in src/server/auth/auth.ts); orgs can add their own via the Leads service.
model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  order          Int
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  leads          Lead[]

  @@unique([organizationId, name])
  @@index([organizationId, order])
  @@map("pipeline_stage")
}

model Lead {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String
  stageId        String
  stage          PipelineStage  @relation(fields: [stageId], references: [id])
  value          Decimal        @default(0) @db.Decimal(14, 2)
  probability    Int            @default(0)
  source         String?
  ownerId        String?
  owner          User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?          @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  closedAt       DateTime?
  activities     LeadActivity[]
  tasks          Task[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, stageId])
  @@index([organizationId, companyId])
  @@map("lead")
}

enum LeadActivityType {
  note
  stage_changed
  task_created
  ai_note
  ai_analysis
  email
  call
  meeting
}

/// Append-only timeline for a lead. Written by user actions (notes, manual
/// stage changes) and by the AI Sales Employee's tools (ai_note, ai_analysis)
/// — never updated or deleted.
model LeadActivity {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           LeadActivityType
  body           String?
  metadata       Json             @default("{}")
  actorId        String?
  actor          User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([organizationId, type])
  @@map("lead_activity")
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         TaskStatus   @default(todo)
  priority       TaskPriority @default(medium)
  dueDate        DateTime?
  reminderAt     DateTime?
  reminderSentAt DateTime?
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?
  deletedAt      DateTime?

  @@index([organizationId, deletedAt])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, dueDate])
  @@index([leadId])
  @@map("task")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 2: Agent orchestration — multi-step planning, tool execution,
// human-in-the-loop approval for the AI Sales Employee
// ─────────────────────────────────────────────────────────────────────────

enum AgentRunStatus {
  planning
  running
  waiting_approval
  completed
  failed
  rejected
}

enum AgentStepStatus {
  pending
  running
  succeeded
  failed
  skipped
}

enum AgentApprovalStatus {
  pending
  approved
  rejected
}

/// One row per user request handed to the AI Sales Employee agent. Tracks
/// the plan the model proposed and the overall outcome of executing it.
/// `goal` is the original user instruction; `plan` is the ordered list of
/// proposed tool calls the planner produced (informational — `AgentStep`
/// rows are the source of truth for what actually ran).
model AgentRun {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  goal           String
  plan           Json
  status         AgentRunStatus  @default(planning)
  resultSummary  String?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?
  steps          AgentStep[]
  approvals      AgentApproval[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([conversationId])
  @@map("agent_run")
}

/// One row per planned tool call within an `AgentRun`, in execution order.
/// `input`/`output` mirror `ToolInvocation` but are scoped to the run so a
/// run's full step-by-step trace can be reconstructed and displayed without
/// joining across conversations.
model AgentStep {
  id           String          @id @default(cuid())
  agentRunId   String
  agentRun     AgentRun        @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  stepIndex    Int
  toolName     String
  input        Json
  output       Json?
  status       AgentStepStatus @default(pending)
  errorMessage String?
  approvalId   String?         @unique
  approval     AgentApproval?  @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())

  @@unique([agentRunId, stepIndex])
  @@index([agentRunId])
  @@map("agent_step")
}

/// A human-approval gate for a single risky step. Created when the agent
/// reaches a step whose tool is classified as requiring approval; the run
/// halts in `waiting_approval` until a member with the underlying tool's
/// own required permission approves or rejects it.
model AgentApproval {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentRunId     String
  agentRun       AgentRun            @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  step           AgentStep?
  toolName       String
  input          Json
  reason         String
  status         AgentApprovalStatus @default(pending)
  decidedById    String?
  decidedBy      User?               @relation("AgentApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime            @default(now())

  @@index([organizationId, status])
  @@index([agentRunId])
  @@map("agent_approval")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 3: Billing — plans, subscriptions, usage metering
// ─────────────────────────────────────────────────────────────────────────

enum PlanTier {
  free
  pro
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

enum UsageMetric {
  ai_tokens
  agent_run
}

/// The billing plan catalog. A small, global reference table (no
/// organizationId — every organization can subscribe to any plan), seeded
/// idempotently at runtime by `ensurePlansSeeded()` rather than via a
/// migration data step, so it needs no separate seed script in CI.
model Plan {
  id                String         @id @default(cuid())
  tier              PlanTier       @unique
  name              String
  monthlyPriceCents Int
  stripePriceId     String?        @unique
  aiTokenLimit      Int
  agentRunLimit     Int
  seatLimit         Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subscriptions     Subscription[]

  @@map("plan")
}

/// One row per organization — every organization has exactly one
/// subscription, provisioned onto the free plan at creation time
/// (`provisionDefaultSubscription`, called from the same
/// `afterCreateOrganization` hook Sprint 1 used for pipeline seeding) and
/// upgraded/downgraded via Stripe checkout + webhooks thereafter.
model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(trialing)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@map("subscription")
}

/// Append-only usage ledger. Current-period usage for a metric is computed
/// on read by summing rows within `[currentPeriodStart, currentPeriodEnd)`
/// of the organization's `Subscription` — there is no running counter to
/// keep in sync, so a missed decrement can never happen.
model UsageRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric         UsageMetric
  quantity       Int
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())

  @@index([organizationId, metric, createdAt])
  @@map("usage_record")
}

/// Idempotency ledger for inbound Stripe webhook events — the event's own
/// Stripe id is the primary key, so a redelivered event is a no-op insert
/// failure the handler catches rather than double-applying a state change.
model BillingWebhookEvent {
  id          String   @id
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@map("billing_webhook_event")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 5: Intelligence — Company Events & Signal Foundation
// ─────────────────────────────────────────────────────────────────────────

enum SignalSourceType {
  domain_event
  scanner
}

enum SignalSeverity {
  low
  medium
  high
  critical
}

enum SignalStatus {
  active
  resolved
  expired
}

/// Durable, queryable ledger of normalized business signals — the landing
/// point for both real-time domain events (`sourceType: domain_event`, via
/// `src/server/intelligence/signals/subscriber.ts`) and periodic deterministic
/// detection rules (`sourceType: scanner`, via
/// `src/server/intelligence/signals/scanner.ts`). `type` is intentionally a
/// free-form String (like `AuditLog.action`/`DomainEvent.type`), not an enum,
/// since the signal vocabulary is expected to grow with every future
/// Opportunity/Risk rule without needing a migration per addition.
/// `relatedEntityType`/`relatedEntityId` are a deliberate soft reference
/// (not a Prisma relation) so this model never requires a back-relation on
/// Lead/Task/Contact/Company — those models are untouched by this sprint.
model CompanySignal {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type              String
  sourceType        SignalSourceType
  sourceId          String
  payload           Json             @default("{}")
  severity          SignalSeverity
  confidence        Int
  relatedEntityType String?
  relatedEntityId   String?
  detectedAt        DateTime         @default(now())
  ruleName          String
  ruleVersion       String
  status            SignalStatus     @default(active)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([organizationId, sourceType, ruleName, ruleVersion, sourceId])
  @@index([organizationId, detectedAt])
  @@index([organizationId, relatedEntityType, relatedEntityId])
  @@index([organizationId, status])
  @@map("company_signal")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 6: Intelligence — Sales Health & Opportunity V1
// ─────────────────────────────────────────────────────────────────────────

/// Append-only history of computed Sales Health scores — like `AuditLog`/
/// `UsageRecord`, a new row per computation rather than an in-place update,
/// so a future Company Pulse UI can show a trend ("what changed") instead of
/// only the current value. `ruleVersion` mirrors `CompanySignal`'s pattern —
/// the scoring formula can evolve without reinterpreting historical rows.
model CompanyHealthSnapshot {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesHealthScore Int
  evidence         Json         @default("{}")
  ruleVersion      String
  computedAt       DateTime     @default(now())

  @@index([organizationId, computedAt])
  @@map("company_health_snapshot")
}

enum OpportunityStatus {
  new
  reviewed
  acted
  dismissed
  expired
}

enum OpportunityEffort {
  low
  medium
  high
}

/// A scored, explained, actionable business opportunity derived from one or
/// more `CompanySignal` rows (`sourceSignalId`, a soft reference — see
/// `CompanySignal`'s own doc comment for why these aren't real Prisma
/// relations). `urgency`/`risk` reuse the `SignalSeverity` enum since both
/// are genuinely severity-shaped; `effort` gets its own small enum since
/// "critical effort" isn't a meaningful concept. Upserted like
/// `CompanySignal` (same `[organizationId, ruleName, ruleVersion,
/// relatedEntityType, relatedEntityId]` idempotency shape) — a re-detection
/// refreshes evidence/score but the generator never overwrites `status`
/// once a human has moved it off `new` (no UI exists to do that yet in this
/// sprint, but the field is forward-compatible for when one does).
model Opportunity {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type              String
  title             String
  description       String
  score             Int
  confidence        Int
  potentialImpact   Decimal           @db.Decimal(14, 2)
  effort            OpportunityEffort
  urgency           SignalSeverity
  risk              SignalSeverity
  evidence          Json              @default("{}")
  explanation       String
  relatedEntityType String?
  relatedEntityId   String?
  sourceSignalId    String?
  status            OpportunityStatus @default(new)
  ruleName          String
  ruleVersion       String
  detectedAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([organizationId, ruleName, ruleVersion, relatedEntityType, relatedEntityId])
  @@index([organizationId, status])
  @@index([organizationId, detectedAt])
  @@map("opportunity")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 7: Intelligence — Risk Engine V1
// ─────────────────────────────────────────────────────────────────────────

enum RiskStatus {
  open
  resolved
  dismissed
}

/// A scored, explained business risk derived from a `CompanySignal` row
/// (`sourceSignalId`, a soft reference — see `CompanySignal`'s own doc
/// comment for why these aren't real Prisma relations), mirroring
/// `Opportunity`'s shape and upsert idempotency
/// (`[organizationId, ruleName, ruleVersion, relatedEntityType,
/// relatedEntityId]`). Unlike `Opportunity`, whose `status` a human must
/// change, a `Risk`'s `status` auto-transitions `open` -> `resolved` when
/// its underlying condition clears (see
/// `src/server/intelligence/risk/service.ts`) — a risk describes an
/// ongoing state, not a discrete action item, so it should auto-clear the
/// way a monitoring alert does. A human's `dismissed` is never
/// auto-overwritten either way.
model Risk {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type              String
  title             String
  description       String
  severity          SignalSeverity
  confidence        Int
  potentialLoss     Decimal        @db.Decimal(14, 2)
  evidence          Json           @default("{}")
  explanation       String
  relatedEntityType String?
  relatedEntityId   String?
  sourceSignalId    String?
  status            RiskStatus     @default(open)
  ruleName          String
  ruleVersion       String
  detectedAt        DateTime       @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([organizationId, ruleName, ruleVersion, relatedEntityType, relatedEntityId])
  @@index([organizationId, status])
  @@index([organizationId, detectedAt])
  @@map("risk")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 8: Intelligence — Decision Engine V1
// ─────────────────────────────────────────────────────────────────────────

/// An organization-level singleton (one row per `[organizationId, ruleName,
/// ruleVersion]` — no `relatedEntityId`, unlike `Opportunity`/`Risk`) holding
/// the single current "what matters most right now" recommendation, ranked
/// across the organization's open `Risk`s and active `Opportunity`s
/// (`sourceType`/`sourceId` point at whichever one won — a soft reference,
/// same reasoning as `CompanySignal`'s). Fully recomputed on every pass
/// (`src/server/intelligence/decision/service.ts`) rather than carrying a
/// human-editable `status`: this is read-only advisory synthesis, not a
/// discrete action item, so there is nothing for a human to triage here —
/// only `Opportunity`/`Risk` themselves are ever actioned. The row is
/// deleted entirely once no open Risk or active Opportunity remains, so a
/// stale recommendation never lingers pointing at something already
/// resolved elsewhere.
model Decision {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleName       String
  ruleVersion    String
  recommendation String
  rationale      String
  sourceType     String
  sourceId       String
  priorityScore  Decimal      @db.Decimal(14, 2)
  evidence       Json         @default("{}")
  detectedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, ruleName, ruleVersion])
  @@index([organizationId, detectedAt])
  @@map("decision")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 9: Policy & Controlled Autonomy
// ─────────────────────────────────────────────────────────────────────────

enum AutonomyLevel {
  L0
  L1
  L2
  L3
  L4
  L5
}

enum AutonomousActionOutcome {
  executed
  blocked_policy
  blocked_limit
  blocked_kill_switch
  blocked_not_allowlisted
  requires_approval
}

enum AutonomousActionTrigger {
  interactive_chat
  agent_run
  scheduler
  event
}

/// Current autonomy policy for one organization × domain (e.g. `"crm"`).
/// The fast-lookup row `resolveAutonomyDecision`
/// (`src/server/ai/autonomy/resolve.ts`) reads on every mutating tool call;
/// `AutonomyPolicyVersion` below is the immutable history every write to
/// this row also appends to. `level` is further clamped at read time by a
/// hardcoded, non-DB-overridable per-domain ceiling
/// (`MAX_AUTONOMY_LEVEL_BY_DOMAIN`) — this row can request L5, but a
/// `market`-domain row can never actually reach it. All four limit/kill
/// fields default to the safest possible values (see the policy service):
/// `level: L2` (today's real, observed behavior — zero regression),
/// every limit `0` (L4/L5 structurally inert until an owner deliberately
/// raises them), `killSwitchEngaged: false`.
model AutonomyPolicy {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain             String
  level              AutonomyLevel @default(L2)
  dailyActionLimit   Int           @default(0)
  dailyRiskLimit     Decimal       @default(0) @db.Decimal(14, 2)
  perActionRiskLimit Decimal       @default(0) @db.Decimal(14, 2)
  killSwitchEngaged  Boolean       @default(false)
  updatedById        String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([organizationId, domain])
  @@map("autonomy_policy")
}

/// Append-only, immutable history of every `AutonomyPolicy` change —
/// like `AuditLog`, never updated or deleted. `versionNumber` is
/// monotonically increasing per `[organizationId, domain]`, assigned inside
/// the same transaction that updates `AutonomyPolicy`, so the two can never
/// drift out of step.
model AutonomyPolicyVersion {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain             String
  versionNumber      Int
  level              AutonomyLevel
  dailyActionLimit   Int
  dailyRiskLimit     Decimal       @db.Decimal(14, 2)
  perActionRiskLimit Decimal       @db.Decimal(14, 2)
  killSwitchEngaged  Boolean
  changedById        String
  changeReason       String?
  createdAt          DateTime      @default(now())

  @@unique([organizationId, domain, versionNumber])
  @@index([organizationId, domain, createdAt])
  @@map("autonomy_policy_version")
}

/// The explicit, owner-curated set of (domain, tool) pairs an organization
/// has opted into allowing at L4/L5 — necessary but not sufficient: a tool
/// must ALSO be statically marked `autonomyEligible: true` in code
/// (`RegisteredTool`, `src/server/ai/tools/types.ts`) before an allowlist
/// entry has any effect. An org can never make a tool autonomous that its
/// own developer never opted in.
model AutonomyAllowlistEntry {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain           String
  toolName         String
  minLevelRequired AutonomyLevel
  addedById        String
  createdAt        DateTime      @default(now())

  @@unique([organizationId, domain, toolName])
  @@index([organizationId, domain])
  @@map("autonomy_allowlist_entry")
}

/// The full decision trail for every mutating-tool autonomy resolution —
/// written synchronously inside `resolveAutonomyDecision` for EVERY
/// outcome, including every `blocked_*` one, not just successful
/// executions. Deliberately written inline rather than via the event bus:
/// a safety-decision record must never be skippable the way a best-effort
/// event publish can be. `toolInvocationId` is a soft link (see
/// `CompanySignal`'s own doc comment for why these aren't real Prisma
/// relations) to the `ToolInvocation` row `executeToolCall` writes, present
/// only once execution actually happened.
model AutonomousActionLog {
  id                         String                  @id @default(cuid())
  organizationId             String
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain                     String
  toolName                   String
  level                      AutonomyLevel
  outcome                    AutonomousActionOutcome
  policyVersionId            String?
  allowlistEntryId           String?
  input                      Json
  output                     Json?
  errorMessage               String?
  dailyActionCountAtDecision Int
  dailyRiskUsedAtDecision    Decimal                 @db.Decimal(14, 2)
  actionRiskValue            Decimal?                @db.Decimal(14, 2)
  toolInvocationId           String?
  triggeredBy                AutonomousActionTrigger
  createdAt                  DateTime                @default(now())

  @@index([organizationId, domain, createdAt])
  @@index([organizationId, outcome])
  @@map("autonomous_action_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 11: Outcome & Learning Loop
// ─────────────────────────────────────────────────────────────────────────

/// The classification a deterministic evaluation rule (or a human) assigns
/// once evidence exists — deliberately NOT forced into a binary
/// success/failure: `neutral` covers a human's own judgment call (e.g.
/// dismissing an Opportunity) that isn't itself a verdict on whether the
/// detection was right; `expired` covers a flag that aged out without ever
/// being resolved either way; `reversed` covers evidence that a previously
/// `success` (or otherwise settled) outcome no longer holds; `unknown` is
/// reserved for a human's own explicit "can't tell" confirmation. This is a
/// closed, stable set (like `RiskStatus`/`OpportunityStatus`), not an
/// open per-rule vocabulary (like `CompanySignal.type`), so it's a proper
/// enum rather than a String.
enum OutcomeType {
  success
  failure
  neutral
  expired
  reversed
  unknown
}

/// The lifecycle of an `Outcome` row, independent of `OutcomeType` — an
/// `Outcome` can exist long before enough evidence exists to classify it.
/// `pending` (evidence expected but not due yet) and `insufficient_evidence`
/// (evidence was checked for but the underlying data is gone/inconclusive)
/// are deliberately distinct from any `OutcomeType` value: "no evidence yet"
/// must never be conflatable with "it failed" (see `Outcome.outcomeType`,
/// which stays null for both of these).
enum OutcomeEvaluationStatus {
  pending
  evaluated
  insufficient_evidence
}

/// Where the evidence backing an `Outcome` came from. Deliberately limited
/// to what CompanyOS can actually produce today — no `customer`/
/// `business_record`/`external` values, since no such integration exists
/// yet and inventing the enum member without a real producer would be
/// exactly the kind of fabrication Sprint 11 must avoid. `system` is a
/// deterministic evaluation rule reading database state (see
/// `src/server/intelligence/outcome/rules/`); `human` is an explicit,
/// RBAC-gated confirmation (`outcome:confirm`) — never an AI tool call, so
/// an LLM can never masquerade as ground truth (see `confirmOutcome` in
/// `src/server/intelligence/outcome/service.ts`).
enum OutcomeSource {
  system
  human
}

/// Durable record of what actually happened after a Decision, Opportunity,
/// Risk, or autonomous action (`AutonomousActionLog`) — the "Action ->
/// Outcome" half of the Decision -> Action -> Outcome -> Evaluation ->
/// Learning loop. Follows the SAME polymorphic soft-reference pattern
/// `CompanySignal`/`Opportunity`/`Risk`/`Decision` already use
/// (`relatedEntityType`/`relatedEntityId`, no Prisma `@relation` to the
/// subject) rather than inventing a new abstraction or a hard FK per
/// subject type — `autonomousActionLogId`/`decisionId`/`signalId` are
/// additional, optional soft cross-references for when a rule also needs
/// to name a related record beyond its primary subject (e.g. which
/// autonomous action caused this Opportunity's outcome).
///
/// One row per `[organizationId, ruleName, ruleVersion, relatedEntityType,
/// relatedEntityId]` (identical idempotency shape to `Opportunity`/`Risk`)
/// — re-running discovery/evaluation upserts the same row rather than
/// duplicating it. The row is mutated in place as evidence accumulates
/// (`pending` -> `evaluated`, or later `success` -> `reversed`); `AuditLog`
/// (not a second history table) is the append-only trail of those
/// transitions — every write here also writes an `outcome.*` `AuditLog`
/// entry with the before/after state in `metadata`.
///
/// `outcomeType`/`source`/`confidence` are deliberately nullable: they stay
/// null for as long as `evaluationStatus` is `pending` or
/// `insufficient_evidence` — never fabricated, never defaulted to a
/// guessed value.
model Outcome {
  id                    String                  @id @default(cuid())
  organizationId        String
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedEntityType     String
  relatedEntityId       String
  autonomousActionLogId String?
  decisionId            String?
  signalId              String?
  ruleName              String
  ruleVersion           String
  evaluationStatus      OutcomeEvaluationStatus @default(pending)
  outcomeType           OutcomeType?
  source                OutcomeSource?
  confidence            Int?
  value                 Decimal?                @db.Decimal(14, 2)
  currency              String?
  evidence              Json                    @default("{}")
  observationDueAt      DateTime?
  observedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([organizationId, ruleName, ruleVersion, relatedEntityType, relatedEntityId])
  @@index([organizationId, evaluationStatus])
  @@index([organizationId, relatedEntityType, relatedEntityId])
  @@index([organizationId, createdAt])
  @@index([organizationId, ruleName, ruleVersion])
  @@map("outcome")
}

/// A structured, durable performance-measurement snapshot derived from one
/// evaluated `Outcome` — NOT a second copy of the outcome, and explicitly
/// NOT AI conversational memory (never written to `MemoryRecord`; see
/// `src/server/intelligence/learning/service.ts`). Exists because
/// `expectedValue` must be captured AT THE MOMENT of evaluation: the
/// Opportunity/Risk rows a `LearningRecord` derives from are live-mutable
/// (e.g. `Opportunity.potentialImpact` is refreshed on every re-detection
/// pass), so joining live at query time later would silently answer a
/// different question than "what did we expect back when we learned this."
/// One row per `Outcome` (`outcomeId` unique) — re-running the learning
/// step on an already-recorded outcome is a no-op, not a duplicate.
model LearningRecord {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outcomeId             String       @unique
  decisionId            String?
  autonomousActionLogId String?
  relatedEntityType     String
  relatedEntityId       String
  ruleName              String
  ruleVersion           String
  outcomeType           OutcomeType
  expectedValue         Decimal?     @db.Decimal(14, 2)
  observedValue         Decimal?     @db.Decimal(14, 2)
  errorValue            Decimal?     @db.Decimal(14, 2)
  evaluationConfidence  Int
  createdAt             DateTime     @default(now())

  @@index([organizationId, ruleName, ruleVersion])
  @@index([organizationId, createdAt])
  @@map("learning_record")
}

// ─────────────────────────────────────────────────────────────────────────
// Sprint 16: Leveraged Paper Trading Engine (SIMULATION ONLY)
//
// Every model below represents a SIMULATED position against a SIMULATED
// virtual account. None of it is connected to a real Binance account, a
// real balance, a real order, or real money in any way -- there is no
// credential anywhere in this codebase that could make that true. See
// `src/server/intelligence/paper-trading/README` doc comment (and the
// project README's own "Leveraged Paper Trading Engine" section) for the
// full architecture, formulas, and explicit PAPER ONLY warning.
// ─────────────────────────────────────────────────────────────────────────

enum PaperPositionDirection {
  LONG
  SHORT
}

/// SPOT: leverage is always 1, never liquidated (matches real spot -- you
/// can hold at a loss but nothing forces a close). PERPETUAL_SIMULATION:
/// leverage may exceed 1, funding accrues, and a `liquidationPrice` is
/// computed. This is the ONLY axis that determines whether leverage/
/// liquidation/funding apply -- never a separate, independently-settable
/// flag that could drift out of sync with `leverage`.
enum PaperPositionMode {
  SPOT
  PERPETUAL_SIMULATION
}

/// `PENDING` exists for forward-compatibility (e.g. a future limit-style
/// paper entry that waits for a price condition) but Sprint 16's own entry
/// logic is fully synchronous/deterministic given already-fresh data, so a
/// position is created directly as `OPEN` -- `PENDING` is never actually
/// produced this sprint. `CLOSED` is the generic terminal state for a close
/// not covered by one of the four specific reasons below (e.g. a future
/// manual/administrative close); `STOPPED`/`TAKE_PROFIT`/`LIQUIDATED`/
/// `INVALIDATED` are each a specific, deterministic close reason recorded
/// as its own status rather than a separate free-text field.
enum PaperPositionStatus {
  PENDING
  OPEN
  CLOSED
  STOPPED
  TAKE_PROFIT
  LIQUIDATED
  INVALIDATED
}

/// One PAPER/SIMULATION-ONLY virtual account per organization (lazily
/// created on first use, mirroring `AutonomyPolicy`'s own lazy-default
/// pattern). Never represents a real Binance account or real balance --
/// `startingEquity` is an explicitly-configured simulation input (default
/// 10,000 USDT, see `paper-trading/constants.ts`), never inferred from
/// anything real. `peakEquity` is tracked so drawdown can be computed at
/// read time (`(peakEquity - currentEquity) / peakEquity`) without storing
/// a redundant derived percentage that could drift out of sync.
model PaperAccount {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startingEquity Decimal      @db.Decimal(18, 8)
  currentEquity  Decimal      @db.Decimal(18, 8)
  peakEquity     Decimal      @db.Decimal(18, 8)
  usedMargin     Decimal      @db.Decimal(18, 8)
  unrealizedPnl  Decimal      @db.Decimal(18, 8)
  realizedPnl    Decimal      @db.Decimal(18, 8)
  totalFees      Decimal      @db.Decimal(18, 8)
  totalFunding   Decimal      @db.Decimal(18, 8)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("paper_account")
}

/// A single simulated position, opened from a Sprint 15 `StrategyCandidate`
/// (soft-referenced via `strategySignalId` -- the originating
/// `CompanySignal.id`, the same soft-reference convention `Opportunity`/
/// `Risk`/`Outcome` already use; see `CompanySignal`'s own doc comment).
/// Every price/quantity/P&L field is SIMULATED -- see the project README's
/// Paper Trading section for the exact, documented formulas behind each
/// one. Idempotency for "don't open a second position on a symbol that
/// already has one open" is enforced in application code (a
/// `findFirst`-then-branch check, mirroring `Risk`'s own auto-transition
/// pattern in `market-intelligence/generate.ts`) rather than a DB
/// constraint, since `CLOSED` history for the same symbol must remain
/// queryable and unique.
model PaperPosition {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId             String
  symbol                String
  direction             PaperPositionDirection
  mode                  PaperPositionMode
  status                PaperPositionStatus    @default(OPEN)
  strategyType          String
  strategySignalId      String?
  regime                String?
  /// The Sprint 15 `StrategyCandidate.score`/`.confidence` snapshotted at
  /// the MOMENT this position opened -- Sprint 17's own Phase 3 requirement.
  /// Never re-read live from `strategySignalId` later: that `CompanySignal`
  /// is upserted in place, so by evaluation time it may already reflect a
  /// NEWER run's candidate for this symbol, silently answering a different
  /// question (the exact trap `opportunity-state-progression.ts`'s own doc
  /// comment already warns against for `Opportunity.potentialImpact`).
  /// Nullable because a position opened before Sprint 17 existed never had
  /// this captured -- `null` here means "unknown," never a fabricated 0.
  candidateScore        Int?
  candidateConfidence   Int?
  leverage              Int
  entryPrice            Decimal                @db.Decimal(18, 8)
  currentPrice          Decimal                @db.Decimal(18, 8)
  exitPrice             Decimal?               @db.Decimal(18, 8)
  quantity              Decimal                @db.Decimal(28, 12)
  notional              Decimal                @db.Decimal(18, 8)
  initialMargin         Decimal                @db.Decimal(18, 8)
  stopLossPrice         Decimal                @db.Decimal(18, 8)
  takeProfitPrice       Decimal                @db.Decimal(18, 8)
  liquidationPrice      Decimal?               @db.Decimal(18, 8)
  riskUnit              Decimal                @db.Decimal(18, 8)
  unrealizedPnl         Decimal                @db.Decimal(18, 8)
  realizedPnl           Decimal?               @db.Decimal(18, 8)
  feesPaid              Decimal                @db.Decimal(18, 8)
  fundingPaid           Decimal                @db.Decimal(18, 8)
  maxFavorableExcursion Decimal                @db.Decimal(18, 8)
  maxAdverseExcursion   Decimal                @db.Decimal(18, 8)
  lastFundingAt         DateTime?
  openedAt              DateTime               @default(now())
  closedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([organizationId, symbol, status])
  @@index([organizationId, status])
  @@index([organizationId, closedAt])
  @@map("paper_position")
}

/// Append-only, immutable record of one CLOSED paper position's final
/// outcome -- created exactly once when a `PaperPosition` transitions to a
/// terminal status. This is the "Outcome-ready record" Sprint 16 Phase 24
/// calls for: a future `Outcome` row can soft-reference it via the
/// existing generic `relatedEntityType: "PaperTrade"` /
/// `relatedEntityId: <this row's id>` pattern `Outcome` already supports
/// (see `Outcome`'s own doc comment) -- no `Outcome` schema change needed.
model PaperTrade {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  positionId            String                 @unique
  symbol                String
  direction             PaperPositionDirection
  mode                  PaperPositionMode
  strategyType          String
  strategySignalId      String?
  regime                String?
  /// Carried through verbatim from `PaperPosition.candidateScore`/
  /// `.candidateConfidence` at close time -- see that field's own doc
  /// comment for why this must be the entry-time snapshot, never a live
  /// re-read.
  candidateScore        Int?
  candidateConfidence   Int?
  leverage              Int
  entryPrice            Decimal                @db.Decimal(18, 8)
  exitPrice             Decimal                @db.Decimal(18, 8)
  quantity              Decimal                @db.Decimal(28, 12)
  notional              Decimal                @db.Decimal(18, 8)
  initialMargin         Decimal                @db.Decimal(18, 8)
  grossPnl              Decimal                @db.Decimal(18, 8)
  feesPaid              Decimal                @db.Decimal(18, 8)
  fundingPaid           Decimal                @db.Decimal(18, 8)
  netPnl                Decimal                @db.Decimal(18, 8)
  returnPct             Decimal                @db.Decimal(10, 4)
  maxFavorableExcursion Decimal                @db.Decimal(18, 8)
  maxAdverseExcursion   Decimal                @db.Decimal(18, 8)
  closeReason           PaperPositionStatus
  openedAt              DateTime
  closedAt              DateTime               @default(now())
  createdAt             DateTime               @default(now())

  @@index([organizationId, symbol])
  @@index([organizationId, closedAt])
  @@index([organizationId, strategyType])
  @@map("paper_trade")
}
