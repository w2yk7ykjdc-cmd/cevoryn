generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  supabaseId    String   @unique @map("supabase_id")
  email         String   @unique
  name          String?
  avatarUrl     String?  @map("avatar_url")
  plan          Plan     @default(FREE)
  stripeCustomerId   String?  @unique @map("stripe_customer_id")
  stripeSubId        String?  @unique @map("stripe_sub_id")
  stripeSubStatus    String?  @map("stripe_sub_status")
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  projects      Project[]
  apiUsage      ApiUsage[]
  @@map("users")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

model Project {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  slug          String   @unique
  customDomain  String?  @unique @map("custom_domain")
  primaryLocale String   @default("en") @map("primary_locale")
  locales       String[] @default(["en"])
  favicon       String?
  ogImage       String?  @map("og_image")
  published     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages         Page[]
  theme         Theme?
  @@index([userId])
  @@map("projects")
}

model Page {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  slug          String   @default("/")
  status        PageStatus @default(DRAFT)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections      Section[]
  seoMeta       SeoMeta[]
  analytics     PageView[]
  @@unique([projectId, slug])
  @@map("pages")
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Section {
  id            String      @id @default(uuid())
  pageId        String      @map("page_id")
  type          SectionType
  order         Int         @default(0)
  settings      Json        @default("{}")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  page          Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contents      SectionContent[]
  @@index([pageId])
  @@map("sections")
}

enum SectionType {
  HERO
  FEATURES
  PRICING
  TESTIMONIALS
  CTA
  FAQ
  FOOTER
  CUSTOM
}

model SectionContent {
  id            String   @id @default(uuid())
  sectionId     String   @map("section_id")
  locale        String
  fields        Json
  aiGenerated   Boolean  @default(false) @map("ai_generated")
  aiReviewedAt  DateTime? @map("ai_reviewed_at")
  humanEdited   Boolean  @default(false) @map("human_edited")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  @@unique([sectionId, locale])
  @@index([sectionId])
  @@map("section_contents")
}

model SeoMeta {
  id            String   @id @default(uuid())
  pageId        String   @map("page_id")
  locale        String
  title         String
  description   String
  ogTitle       String?  @map("og_title")
  ogDescription String?  @map("og_description")
  keywords      String[] @default([])
  hreflang      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@unique([pageId, locale])
  @@map("seo_meta")
}

model Theme {
  id            String   @id @default(uuid())
  projectId     String   @unique @map("project_id")
  template      String   @default("minimal")
  primaryColor  String   @default("#2563EB") @map("primary_color")
  accentColor   String   @default("#F59E0B") @map("accent_color")
  bgColor       String   @default("#FFFFFF") @map("bg_color")
  textColor     String   @default("#111827") @map("text_color")
  fontDisplay   String   @default("Inter") @map("font_display")
  fontBody      String   @default("Inter") @map("font_body")
  borderRadius  Int      @default(8) @map("border_radius")
  customCss     String?  @map("custom_css")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@map("themes")
}

model PageView {
  id            String   @id @default(uuid())
  pageId        String   @map("page_id")
  locale        String
  referrer      String?
  country       String?
  device        String?
  createdAt     DateTime @default(now()) @map("created_at")
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  @@index([pageId, createdAt])
  @@index([pageId, locale])
  @@map("page_views")
}

model ApiUsage {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          UsageType
  tokensUsed    Int      @default(0) @map("tokens_used")
  locale        String?
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("api_usage")
}

enum UsageType {
  TRANSLATE
  GENERATE_COPY
  SEO_META
  LOCALIZE
}
